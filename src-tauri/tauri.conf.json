{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeviceLifeline",
  "identifier": "com.devicelifeline.app",
  "version": "0.3.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DeviceLifeline",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DriftLynx Technologies",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "DeviceLifeline"
      }
    }
  },
  "plugins": {
    "opener": {}
  }
}
