# DeviceLifeline — environment example. Copy to `.env` and fill in as needed.
#
# Copilot LLM keys are read only by the Rust core (never baked into the Vite bundle).

# --- Copilot LLM providers (any one is enough; all three supported) ---
# Preference when multiple keys exist:
#   DEVICELIFELINE_LLM_PROVIDER=xai | openai | gemini
# Default auto order when unset: xai → openai → gemini

# SpaceXAI / xAI — https://console.x.ai
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # accepted as alias for GEMINI_API_KEY
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash

# DEVICELIFELINE_LLM_PROVIDER=xai

# --- Supabase (cloud sync / auth) — scaffolded for later ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Always-on agent ---
# cargo run --bin device-lifeline-agent -- --console --interval-secs 60
# DEVICELIFELINE_AGENT_CONSOLE=1

# --- Elevation (Windows) ---
# DeviceLifeline auto-requests Administrator (UAC) on launch so deep process,
# USN, and disk tools work without "Run as admin". Skip for tests/CI:
# DEVICELIFELINE_SKIP_ELEVATION=1
