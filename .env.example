# DeviceLifeline — environment example. Copy to `.env` and fill in as needed.
#
# IMPORTANT: AI provider keys (OpenAI / Anthropic) are SERVER-SIDE ONLY and live in
# Supabase Edge Functions — they are NEVER shipped in the desktop client. They are also
# NOT used in Increment 1 (the software-inventory slice is fully local-first).

# --- Supabase (cloud sync / auth) — scaffolded for later increments, unused in Increment 1 ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Supabase Edge Function secrets; do NOT put in the client build) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
